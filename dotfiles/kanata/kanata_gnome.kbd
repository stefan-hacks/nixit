(defcfg
  process-unmapped-keys yes
  log-layer-changes no
)

;; Define raw keycode names for keycodes with no built-in string mapping.
;; These are used by the F-row tap-hold aliases below.
(deflocalkeys-linux
  raw232 232   ;; KEY_REPLY (mapped to brightness down on this keyboard)
  raw233 233   ;; KEY_FORWARDMAIL (mapped to brightness up)
  raw234 234   ;; KEY_SAVE (mapped to brightness cycle)
  raw410 410   ;; KEY_SHUFFLE (mapped to rotate display)
)

(defvar
 tap-time 200
 hold-time 200
)

;; ================================================================
;; FULL GNOME CONTROL, 3 layers on top of the base layer:
;;   one   -- normal typing, home-row mods, F-row media/system keys
;;   two   -- Window & Workspace control (hold left Super)
;;             physical Ctrl/Shift/Alt are NOT consumed by this
;;             layer, so holding them alongside a layer-two tap
;;             reaches GNOME's "secondary" bindings for free:
;;               + Ctrl  -> open-new-window-application-N
;;               + Shift -> the "backward" / "-monitor" variant
;;   edit  -- text/terminal editing (hold Spacebar)
;;   four  -- the handful of GNOME actions that ship BLANK by
;;             default (corners, sides, raise/lower, fullscreen,
;;             workspaces 2-9, etc.) -- hold Right Alt.
;;             Requires running gnome-layer4-bindings.sh once;
;;             everything else in this file uses stock GNOME
;;             defaults with zero dconf changes.
;; ================================================================

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  ;; --- layer holds ---
  l2  (tap-hold $tap-time $hold-time lmet (layer-toggle two))
  l3  (tap-hold $tap-time $hold-time spc  (layer-toggle edit))
  l4  (tap-hold $tap-time $hold-time ralt (layer-toggle four))

  ;; --- layer-one home row mods (unchanged) ---
  ss (tap-hold $tap-time $hold-time s lmet)
  dd (tap-hold $tap-time $hold-time d lalt)
  ff (tap-hold $tap-time $hold-time f lctl)
  jj (tap-hold $tap-time $hold-time j rctl)
  kk (tap-hold $tap-time $hold-time k ralt)
  ll (tap-hold $tap-time $hold-time l rmet)
  la (tap-hold $tap-time $hold-time bspc del)
  ra (tap-hold $tap-time $hold-time ret rmet)

  ;; --- layer-one F-row: tap = F-key, hold = shortcut ---
  qtd (tap-hold $tap-time $hold-time f1 C-A-q)
  pum (tap-hold $tap-time $hold-time f2 A-f2)             ;; panel-run-dialog (default)
  vdn (tap-hold $tap-time $hold-time f3 raw232)        ;; brightness down (F3)
  vup (tap-hold $tap-time $hold-time f4 raw233)        ;; brightness up (F4)
  mut (tap-hold $tap-time $hold-time f5 raw234)        ;; brightness cycle (F5)
  dsb (tap-hold $tap-time $hold-time f6 C-M-down)         ;; workspace down (was F3)
  isb (tap-hold $tap-time $hold-time f7 C-M-up)           ;; workspace up (was F4)
  mic (tap-hold $tap-time $hold-time f8 A-f8)
  psc (tap-hold $tap-time $hold-time f9 prtsc)            ;; screenshot (prtsc)
  lts (tap-hold $tap-time $hold-time f10 C-A-M-l)

  ;; --- layer-one misc (unchanged) ---
  gm  (tap-hold $tap-time $hold-time grv S-grv)
  qq  (tap-hold $tap-time $hold-time q C-q)
  ww  (tap-hold $tap-time $hold-time w C-w)
  rr  (tap-hold $tap-time $hold-time r C-r)
  tt  (tap-hold $tap-time $hold-time t C-t)
  yy  (tap-hold $tap-time $hold-time y home)
  uu  (tap-hold $tap-time $hold-time u pgdn)
  ii  (tap-hold $tap-time $hold-time i pgup)
  oo  (tap-hold $tap-time $hold-time o end)
  so  (tap-hold $tap-time $hold-time [ S-[)
  sc  (tap-hold $tap-time $hold-time ] S-])
  pi  (tap-hold $tap-time $hold-time \ S-\)
  aa  (tap-hold $tap-time $hold-time a C-a)
  se  (tap-hold $tap-time $hold-time ; S-;)
  ap  (tap-hold $tap-time $hold-time ' S-')
  zz  (tap-hold $tap-time $hold-time z C-z)
  xx  (tap-hold $tap-time $hold-time x C-x)
  cc  (tap-hold $tap-time $hold-time c C-c)
  vv  (tap-hold $tap-time $hold-time v C-v)
  co  (tap-hold $tap-time $hold-time , S-,)
  fu  (tap-hold $tap-time $hold-time . S-.)
  fs  (tap-hold $tap-time $hold-time / S-/)
  1m  (tap-hold $tap-time $hold-time 1 S-1)
  2m  (tap-hold $tap-time $hold-time 2 S-2)
  3m  (tap-hold $tap-time $hold-time 3 S-3)
  4m  (tap-hold $tap-time $hold-time 4 S-4)
  5m  (tap-hold $tap-time $hold-time 5 S-5)
  6m  (tap-hold $tap-time $hold-time 6 S-6)
  7m  (tap-hold $tap-time $hold-time 7 S-7)
  8m  (tap-hold $tap-time $hold-time 8 S-8)
  9m  (tap-hold $tap-time $hold-time 9 S-9)
  0m  (tap-hold $tap-time $hold-time 0 S-0)
  mi  (tap-hold $tap-time $hold-time - S--)
  pl  (tap-hold $tap-time $hold-time = S-=)

  ;; -------------------------------------------------------------
  ;; Layer TWO -- Window & Workspace (hold left Super)
  ;; -------------------------------------------------------------
  winmenu  (tap-hold $tap-time $hold-time A-spc A-spc)        ;; activate-window-menu
  app1 (tap-hold $tap-time $hold-time M-1 M-1)                ;; +Ctrl = open-new-window-application-1
  app2 (tap-hold $tap-time $hold-time M-2 M-2)
  app3 (tap-hold $tap-time $hold-time M-3 M-3)
  app4 (tap-hold $tap-time $hold-time M-4 M-4)
  app5 (tap-hold $tap-time $hold-time M-5 M-5)
  app6 (tap-hold $tap-time $hold-time M-6 M-6)
  app7 (tap-hold $tap-time $hold-time M-7 M-7)
  app8 (tap-hold $tap-time $hold-time M-8 M-8)
  app9 (tap-hold $tap-time $hold-time M-9 M-9)
  appview (tap-hold $tap-time $hold-time M-a M-a)             ;; toggle-application-view
  qset    (tap-hold $tap-time $hold-time M-s M-s)             ;; toggle-quick-settings
  mtray   (tap-hold $tap-time $hold-time M-v M-v)             ;; toggle-message-tray

  cyclegrp (tap-hold $tap-time $hold-time A-f6 A-f6)          ;; +Shift = cycle-group-backward
  begmove  (tap-hold $tap-time $hold-time A-f7 A-f7)          ;; begin-move
  begresz  (tap-hold $tap-time $hold-time A-f8 A-f8)          ;; begin-resize
  swmon    (tap-hold $tap-time $hold-time M-p M-p)            ;; switch-monitor
  notif    (tap-hold $tap-time $hold-time M-n M-n)            ;; focus-active-notification
  wsleft   (tap-hold $tap-time $hold-time M-pgup M-pgup)      ;; switch-to-workspace-left
  wsdown   (tap-hold $tap-time $hold-time C-A-down C-A-down)  ;; switch-to-workspace-down
  wsup     (tap-hold $tap-time $hold-time C-A-up C-A-up)      ;; switch-to-workspace-up
  wsright  (tap-hold $tap-time $hold-time M-pgdn M-pgdn)      ;; switch-to-workspace-right
  wslast   (tap-hold $tap-time $hold-time M-end M-end)        ;; switch-to-workspace-last
  monleft  (tap-hold $tap-time $hold-time S-M-left S-M-left)  ;; move-to-monitor-left
  monright (tap-hold $tap-time $hold-time S-M-rght S-M-rght)  ;; move-to-monitor-right
  monup    (tap-hold $tap-time $hold-time S-M-up S-M-up)      ;; move-to-monitor-up

  ws1      (tap-hold $tap-time $hold-time M-home M-home)      ;; switch-to-workspace-1
  mvleft   (tap-hold $tap-time $hold-time S-M-pgup S-M-pgup)  ;; move-to-workspace-left
  mvdown   (tap-hold $tap-time $hold-time C-S-A-down C-S-A-down) ;; move-to-workspace-down
  mvup     (tap-hold $tap-time $hold-time C-S-A-up C-S-A-up)     ;; move-to-workspace-up
  mondown  (tap-hold $tap-time $hold-time S-M-down S-M-down)  ;; move-to-monitor-down
  tileleft (tap-hold $tap-time $hold-time M-left M-left)      ;; toggle-tiled-left
  tileright (tap-hold $tap-time $hold-time M-rght M-rght)     ;; toggle-tiled-right
  wmax     (tap-hold $tap-time $hold-time M-up M-up)          ;; maximize
  wunmax   (tap-hold $tap-time $hold-time M-down M-down)      ;; unmaximize
  wmin     (tap-hold $tap-time $hold-time M-h M-h)            ;; minimize
  mvlast   (tap-hold $tap-time $hold-time S-M-end S-M-end)    ;; move-to-workspace-last

  mvright  (tap-hold $tap-time $hold-time S-M-pgdn S-M-pgdn)  ;; move-to-workspace-right
  mv1      (tap-hold $tap-time $hold-time S-M-home S-M-home)  ;; move-to-workspace-1

  cyclewin (tap-hold $tap-time $hold-time A-esc A-esc)        ;; +Shift = cycle-windows-backward
  switchpan (tap-hold $tap-time $hold-time C-A-tab C-A-tab)   ;; +Shift = switch-panels-backward
  switchsrc (tap-hold $tap-time $hold-time M-spc M-spc)       ;; +Shift = switch-input-source-backward

  ;; -------------------------------------------------------------
  ;; Layer EDIT -- text/terminal editing (hold Spacebar). Unchanged.
  ;; -------------------------------------------------------------
  pp  (tap-hold $tap-time $hold-time C-M-/ C-M-/)
  pt  (tap-hold $tap-time $hold-time C-M-, C-M-,)
  nt  (tap-hold $tap-time $hold-time C-M-. C-M-.)
  dtb (tap-hold $tap-time $hold-time [ C-u)
  dte (tap-hold $tap-time $hold-time ] C-k)
  dwb (tap-hold $tap-time $hold-time , C-bspc)
  dwf (tap-hold $tap-time $hold-time . C-del)
  tbd (tap-hold $tap-time $hold-time , C-w)
  tfd (tap-hold $tap-time $hold-time . A-d)
  mwl (mwheel-left 50 120)
  mwd (mwheel-down 50 120)
  mwu (mwheel-up 50 120)
  mwr (mwheel-right 50 120)

  ;; -------------------------------------------------------------
  ;; Layer FOUR -- everything GNOME ships blank, plus overflow
  ;; system actions (hold Right Alt).
  ;; -------------------------------------------------------------
  ws2 (tap-hold $tap-time $hold-time A-S-2 A-S-2)
  ws3 (tap-hold $tap-time $hold-time A-S-3 A-S-3)
  ws4 (tap-hold $tap-time $hold-time A-S-4 A-S-4)
  ws5 (tap-hold $tap-time $hold-time A-S-5 A-S-5)
  ws6 (tap-hold $tap-time $hold-time A-S-6 A-S-6)
  ws7 (tap-hold $tap-time $hold-time A-S-7 A-S-7)
  ws8 (tap-hold $tap-time $hold-time A-S-8 A-S-8)
  ws9 (tap-hold $tap-time $hold-time A-S-9 A-S-9)
  cancelcap (tap-hold $tap-time $hold-time S-esc S-esc)          ;; (default) cancel-input-capture

  cornernw (tap-hold $tap-time $hold-time C-S-q C-S-q)
  cornerne (tap-hold $tap-time $hold-time C-S-w C-S-w)
  siden    (tap-hold $tap-time $hold-time C-S-e C-S-e)
  cyclepan (tap-hold $tap-time $hold-time C-A-esc C-A-esc)           ;; (default) cycle-panels, +Shift=backward
  rotatemon (tap-hold $tap-time $hold-time raw410 raw410)      ;; KEY_ROTATE_DISPLAY (410)
  screenrec (tap-hold $tap-time $hold-time C-S-A-r C-S-A-r)          ;; (default) show-screen-recording-ui
  sides    (tap-hold $tap-time $hold-time C-S-i C-S-i)
  sidee    (tap-hold $tap-time $hold-time C-S-o C-S-o)
  sidew    (tap-hold $tap-time $hold-time C-S-p C-S-p)
  overview (tap-hold $tap-time $hold-time C-S-[ C-S-[)
  showdesk (tap-hold $tap-time $hold-time C-S-] C-S-])

  cornersw (tap-hold $tap-time $hold-time C-S-a C-S-a)
  cornerse (tap-hold $tap-time $hold-time C-S-s C-S-s)
  center   (tap-hold $tap-time $hold-time C-S-d C-S-d)
  raise    (tap-hold $tap-time $hold-time C-S-f C-S-f)
  lower    (tap-hold $tap-time $hold-time C-S-g C-S-g)
  raiselow (tap-hold $tap-time $hold-time C-S-h C-S-h)
  fullscr  (tap-hold $tap-time $hold-time C-S-j C-S-j)
  alwaystop (tap-hold $tap-time $hold-time C-S-k C-S-k)
  allws    (tap-hold $tap-time $hold-time C-S-l C-S-l)
  maxh     (tap-hold $tap-time $hold-time C-S-; C-S-;)
  maxv     (tap-hold $tap-time $hold-time C-S-' C-S-')

  monbcyc  (tap-hold $tap-time $hold-time raw234 raw234)   ;; brightness cycle
  monbdn   (tap-hold $tap-time $hold-time raw232 raw232)   ;; brightness down
  monbup   (tap-hold $tap-time $hold-time raw233 raw233)   ;; brightness up
  ovdown   (tap-hold $tap-time $hold-time S-A-down S-A-down)         ;; shift-overview-down
  ovup     (tap-hold $tap-time $hold-time S-A-up S-A-up)             ;; shift-overview-up
)

;; ================================================================
;; LAYER ONE -- base layer. Esc/Caps swapped, F1-F10 tap/hold,
;; home-row mods -- exactly as your original.
;; ================================================================
(deflayer one
  caps @qtd @pum @vdn @vup @mut @dsb @isb @mic @psc @lts f11  f12
  @gm  @1m  @2m  @3m  @4m  @5m  @6m  @7m  @8m  @9m  @0m  @mi  @pl  bspc
  tab  @qq  @ww  e    @rr  @tt  @yy  @uu  @ii  @oo  p    @so  @sc  @pi
  esc  @aa  @ss  @dd  @ff  g    h    @jj  @kk  @ll  @se  @ap  ret
  lsft @zz  @xx  @cc  @vv  b    n    m    @co  @fu  @fs  rsft
  lctl @l2  @la           @l3             @l4  _    _
)

;; ================================================================
;; LAYER TWO -- Window & Workspace control (hold left Super).
;; Stock GNOME defaults only. Hold physical Ctrl for
;; open-new-window-application-N on the number row; hold physical
;; Shift for the backward/-monitor variant of cyclegrp/cyclewin/
;; switchpan/switchsrc.
;; ================================================================
(deflayer two
  caps _        _        _        _        _        _        _        _        _        _        _        lrld
  @winmenu @app1 @app2    @app3    @app4    @app5    @app6    @app7    @app8    @app9    @appview @qset    @mtray   bspc
  @switchsrc @cyclegrp @begmove @begresz @swmon @notif @wsleft @wsdown @wsup @wsright @wslast @monleft @monright @monup
  @cyclewin @ws1 @mvleft @mvdown @mvup @mondown @tileleft @tileright @wmax @wunmax @wmin @mvlast @switchpan
  _    @mvright  @mv1     _        _        _        _        _        _        _        _        _
  _    _    _             _                 _    _    _
)

;; ================================================================
;; LAYER EDIT -- text/terminal editing (hold Spacebar). Unchanged.
;; ================================================================
(deflayer edit
  caps @qtd @pum @vdn @vup @mut @dsb @isb @mic @psc @lts _    _
  grv  _    _    _    _    _    _    _    _    _    _    _    _    bspc
  tab  _    _    _    _    _    @mwl @mwd @mwu @mwr p    @dtb @dte _
  esc  _    _    _    _    _    left down up   rght bspc del  ret
  lsft _    _    _    _    _    @dwb @dwf @tbd @tfd _    rsft
  _    _    _           _                 _    _    _
)

;; ================================================================
;; LAYER FOUR -- everything GNOME ships blank + overflow system
;; actions (hold Right Alt). Run gnome-layer4-bindings.sh once.
;; ================================================================
(deflayer four
  _    _    _    _    _    _    _    _    _    _    _    _    _
  @cancelcap @ws2 @ws3 @ws4 @ws5 @ws6 @ws7 @ws8 @ws9 _    _    _    _    bspc
  tab  @cornernw @cornerne @siden @cyclepan @rotatemon @screenrec @sides @sidee @sidew @overview @showdesk _    _
  esc  @cornersw @cornerse @center @raise @lower @raiselow @fullscr @alwaystop @allws @maxh @maxv ret
  lsft @monbcyc @monbdn @monbup @ovdown @ovup _ _ _ _ _ rsft
  _    _    _             _                 _    _    _
)

;; lrld = live-reload (Super + F12) -- reloads this config file
